# Dragonpaw Discord bot as a native systemd service on plugger (replaced the
# ghcr.io/dragonpaw/discord-bot container 2026-11-16). Installed by bin/deploy.
# Code: /opt/discord-bot (git archive HEAD, rsynced, root-owned). Venv: /var/cache/discord-bot/venv,
# built by `uv sync` on
# Arch's system Python, which requires-python must match). An Arch Python major bump
# (e.g. 3.15) breaks the venv: bump requires-python, relock, test, redeploy.
# State: /var/lib/discord-bot, linked as /opt/discord-bot/state.
# Secrets: BOT_TOKEN, CLIENT_ID in /srv/discord-bot/stack.env (root 0600).
[Unit]
Description=Dragonpaw Discord bot
After=network-online.target
Wants=network-online.target
OnFailure=pushover-onfailure@%n.service

[Service]
User=discord-bot
Group=discord-bot
WorkingDirectory=/opt/discord-bot
EnvironmentFile=/srv/discord-bot/stack.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/var/cache/discord-bot/venv/bin/python -OO -m dragonpaw_bot
Restart=always
RestartSec=10
# Interactions have a 3 s deadline; win the CPU the moment one lands (was cpu_shares 4096).
CPUWeight=400
StateDirectory=discord-bot
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
